# 배포 도메인 (OG 이미지 절대경로용) — 비워두면 Vercel이 주는
# VERCEL_PROJECT_PRODUCTION_URL을 자동으로 쓴다. 커스텀 도메인을 붙였다면 그 주소를 넣는다.
NEXT_PUBLIC_SITE_URL=

# Supabase — Connect 버튼 또는 Project Settings > API 에서 복사
NEXT_PUBLIC_SUPABASE_URL=
# 아래 둘 중 하나만 채우면 된다 (신규 프로젝트는 publishable, 기존은 anon)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudinary — 갤러리 이미지 업로드용 (대시보드 > API Keys)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 카카오맵 JavaScript 키 (About 페이지 지도)
NEXT_PUBLIC_KAKAO_MAP_KEY=

# 구글 시트 참가자 명단 동기화 (관리자 > 설정)
# 시트 주소를 통째로 넣어도 되고 ID만 넣어도 된다
GOOGLE_SHEETS_ID=
# 읽을 범위. 탭 이름을 붙이면 '참가자!A:Z' 처럼 적는다.
# 비우면 A:Z — 첫 번째 탭을 읽으므로 탭 이름을 바꿔도 안 깨진다.
GOOGLE_SHEETS_RANGE=
# GCP 서비스 계정 — 만든 뒤 시트를 이 이메일에 '뷰어'로 공유해야 읽힌다.
# 받은 JSON 키 파일에서 아래 두 값만 꺼내 넣는다 (client_email, private_key)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# private_key 값. 줄바꿈이 
으로 이스케이프된 형태 그대로 넣으면 된다
GOOGLE_SERVICE_ACCOUNT_KEY=

# 관리자 가입 요청 알림 (웹 푸시)
# 키 한 쌍은 npx web-push generate-vapid-keys 로 만든다
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:운영자메일
# 관리자 푸시 주소만 읽는 좁은 열쇠. 해시는 마이그레이션 0035에 있다 —
# 값을 바꾸면 그 해시도 함께 바꿔야 한다. 서버 전용, 절대 NEXT_PUBLIC 아님
PUSH_SECRET=
